{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "installDir": "${sourceDir}/out/install/${presetName}",
      "cacheVariables": {
        "SOCKGATE_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "windows-base",
      "hidden": true,
      "inherits": "base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "architecture": { "value": "x64", "strategy": "external" },
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows-static-md",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/vcpkg_installed",
        "OPENSSL_USE_STATIC_LIBS": "ON",
        "OPENSSL_MSVC_STATIC_RT": "OFF"
      }
    },
    {
      "name": "windows-msvc-base",
      "hidden": true,
      "inherits": "windows-base",
      "cacheVariables": { "CMAKE_C_COMPILER": "cl", "CMAKE_CXX_COMPILER": "cl" }
    },
    {
      "name": "windows-clangcl-base",
      "hidden": true,
      "inherits": "windows-base",
      "cacheVariables": { "CMAKE_C_COMPILER": "clang-cl", "CMAKE_CXX_COMPILER": "clang-cl" }
    },
    {
      "name": "windows-msvc-debug",
      "displayName": "Windows MSVC Debug",
      "inherits": "windows-msvc-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "windows-msvc-release",
      "displayName": "Windows MSVC Release",
      "inherits": "windows-msvc-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "SOCKGATE_WERROR": "ON" }
    },
    {
      "name": "windows-clangcl-debug",
      "displayName": "Windows clang-cl Debug",
      "inherits": "windows-clangcl-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "windows-clangcl-release",
      "displayName": "Windows clang-cl Release",
      "inherits": "windows-clangcl-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "SOCKGATE_WERROR": "ON" }
    },
    {
      "name": "windows-msvc-asan",
      "displayName": "Windows MSVC AddressSanitizer",
      "inherits": "windows-msvc-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "SOCKGATE_SANITIZER": "address" }
    },
    {
      "name": "windows-msvc-fuzz",
      "displayName": "Windows MSVC libFuzzer + ASan",
      "inherits": "windows-msvc-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "SOCKGATE_SANITIZER": "address",
        "SOCKGATE_BUILD_FUZZERS": "ON",
        "SOCKGATE_BUILD_SHARED": "OFF"
      }
    },
    {
      "name": "linux-base",
      "hidden": true,
      "inherits": "base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
    },
    {
      "name": "linux-gcc-base",
      "hidden": true,
      "inherits": "linux-base",
      "cacheVariables": { "CMAKE_C_COMPILER": "gcc", "CMAKE_CXX_COMPILER": "g++" }
    },
    {
      "name": "linux-clang-base",
      "hidden": true,
      "inherits": "linux-base",
      "cacheVariables": { "CMAKE_C_COMPILER": "clang", "CMAKE_CXX_COMPILER": "clang++" }
    },
    {
      "name": "linux-gcc-debug",
      "displayName": "Linux GCC Debug",
      "inherits": "linux-gcc-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "linux-gcc-release",
      "displayName": "Linux GCC Release",
      "inherits": "linux-gcc-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "SOCKGATE_WERROR": "ON" }
    },
    {
      "name": "linux-clang-debug",
      "displayName": "Linux Clang Debug",
      "inherits": "linux-clang-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "linux-clang-release",
      "displayName": "Linux Clang Release",
      "inherits": "linux-clang-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "SOCKGATE_WERROR": "ON" }
    },
    {
      "name": "linux-gcc-asan",
      "displayName": "Linux GCC ASan + UBSan",
      "inherits": "linux-gcc-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "SOCKGATE_SANITIZER": "address+undefined" }
    },
    {
      "name": "linux-clang-asan",
      "displayName": "Linux Clang ASan + UBSan",
      "inherits": "linux-clang-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "SOCKGATE_SANITIZER": "address+undefined" }
    },
    {
      "name": "linux-clang-tsan",
      "displayName": "Linux Clang ThreadSanitizer",
      "inherits": "linux-clang-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "SOCKGATE_SANITIZER": "thread" }
    },
    {
      "name": "linux-clang-fuzz",
      "displayName": "Linux Clang libFuzzer + ASan + UBSan",
      "inherits": "linux-clang-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "SOCKGATE_SANITIZER": "address+undefined",
        "SOCKGATE_BUILD_FUZZERS": "ON",
        "SOCKGATE_BUILD_SHARED": "OFF"
      }
    }
  ],
  "buildPresets": [
    { "name": "windows-msvc-debug",      "configurePreset": "windows-msvc-debug" },
    { "name": "windows-msvc-release",    "configurePreset": "windows-msvc-release" },
    { "name": "windows-clangcl-debug",   "configurePreset": "windows-clangcl-debug" },
    { "name": "windows-clangcl-release", "configurePreset": "windows-clangcl-release" },
    { "name": "windows-msvc-asan",       "configurePreset": "windows-msvc-asan" },
    { "name": "windows-msvc-fuzz",       "configurePreset": "windows-msvc-fuzz" },
    { "name": "linux-gcc-debug",         "configurePreset": "linux-gcc-debug" },
    { "name": "linux-gcc-release",       "configurePreset": "linux-gcc-release" },
    { "name": "linux-clang-debug",       "configurePreset": "linux-clang-debug" },
    { "name": "linux-clang-release",     "configurePreset": "linux-clang-release" },
    { "name": "linux-gcc-asan",          "configurePreset": "linux-gcc-asan" },
    { "name": "linux-clang-asan",        "configurePreset": "linux-clang-asan" },
    { "name": "linux-clang-tsan",        "configurePreset": "linux-clang-tsan" },
    { "name": "linux-clang-fuzz",        "configurePreset": "linux-clang-fuzz" }
  ],
  "testPresets": [
    { "name": "test-base", "hidden": true, "output": { "outputOnFailure": true }, "execution": { "noTestsAction": "error", "timeout": 300 } },
    {
      "name": "test-sanitizers", "hidden": true, "inherits": "test-base",
      "environment": {
        "ASAN_OPTIONS": "detect_leaks=1:strict_string_checks=1:detect_stack_use_after_return=1",
        "UBSAN_OPTIONS": "halt_on_error=1:print_stacktrace=1",
        "TSAN_OPTIONS": "halt_on_error=1 second_deadlock_stack=1"
      }
    },
    { "name": "windows-msvc-debug",      "inherits": "test-base", "configurePreset": "windows-msvc-debug" },
    { "name": "windows-msvc-release",    "inherits": "test-base", "configurePreset": "windows-msvc-release" },
    { "name": "windows-clangcl-debug",   "inherits": "test-base", "configurePreset": "windows-clangcl-debug" },
    { "name": "windows-clangcl-release", "inherits": "test-base", "configurePreset": "windows-clangcl-release" },
    { "name": "windows-msvc-asan",       "inherits": "test-base", "configurePreset": "windows-msvc-asan" },
    { "name": "linux-gcc-debug",         "inherits": "test-base", "configurePreset": "linux-gcc-debug" },
    { "name": "linux-gcc-release",       "inherits": "test-base", "configurePreset": "linux-gcc-release" },
    { "name": "linux-clang-debug",       "inherits": "test-base", "configurePreset": "linux-clang-debug" },
    { "name": "linux-clang-release",     "inherits": "test-base", "configurePreset": "linux-clang-release" },
    { "name": "linux-gcc-asan",          "inherits": "test-sanitizers", "configurePreset": "linux-gcc-asan" },
    { "name": "linux-clang-asan",        "inherits": "test-sanitizers", "configurePreset": "linux-clang-asan" },
    { "name": "linux-clang-tsan",        "inherits": "test-sanitizers", "configurePreset": "linux-clang-tsan" }
  ]
}
